# Copy to .env and fill in. .env is git-ignored, so these survive every update
# and never reach a commit.
#
#   npm run license:init                       -> MOBILESHOP_LICENSE_PUBLIC_KEY
#   npm run dev:password -- "several words"    -> MOBILESHOP_DEV_PASSWORD_HASH_B64
#
# Then confirm with:  npm run check:env && npm run check:keypair

# Ed25519 PUBLIC key. Safe to ship: it verifies licences, it cannot mint them.
# The matching PRIVATE key stays in scripts/.license-key — back that up.
MOBILESHOP_LICENSE_PUBLIC_KEY=

# Developer console password, as BASE64 of the bcrypt hash.
#
# Base64 and not the raw hash: this file is read through dotenv-expand, which
# treats `$12$abc` as a variable reference and silently truncates
# `$2a$12$hUAAv...` to `$2a$12`. bcrypt then rejects every password with no
# error anywhere. Base64 contains no `$`, so it cannot be corrupted.
MOBILESHOP_DEV_PASSWORD_HASH_B64=

# Cloudflare Worker, for licensing and remote notices.
MOBILESHOP_API_BASE=
MOBILESHOP_CLIENT_KEY=
