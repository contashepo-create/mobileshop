# Runtime configuration for the desktop app.
#
# Copy this file to `.env` and fill in the values from your own Cloudflare
# Worker. `.env` is git-ignored; this example is not, so it must never contain
# a real key.
#
# Leaving these blank is fine — the app then runs fully offline and the remote
# management feature is simply disabled.

# Base URL of your deployed Worker (no trailing slash).
MOBILESHOP_API_BASE=https://mobileshop-licensing.YOUR-SUBDOMAIN.workers.dev

# Public client key. Ships with the app and only permits posting a heartbeat.
# It CANNOT issue activation codes or read other devices — that requires
# ADMIN_KEY, which stays on your machine and in Cloudflare secrets only.
MOBILESHOP_CLIENT_KEY=
