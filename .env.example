# Copy to .env and fill in. .env is git-ignored, so these survive every update
# and never reach a commit.
#
#   npm run license:init                       -> MOBILESHOP_LICENSE_PUBLIC_KEY
#   npm run dev:password -- "several words"    -> MOBILESHOP_DEV_PASSWORD_HASH

# Ed25519 PUBLIC key. Safe to ship: it verifies licences, it cannot mint them.
# The matching PRIVATE key stays in scripts/.license-key — back that up.
MOBILESHOP_LICENSE_PUBLIC_KEY=

# bcrypt hash of the developer console password.
MOBILESHOP_DEV_PASSWORD_HASH=

# Cloudflare Worker, for licensing and remote notices.
MOBILESHOP_API_BASE=
MOBILESHOP_CLIENT_KEY=
